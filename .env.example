# Everything is free and runs on your machine. Defaults need no downloads at all.
# Nothing loads this file for you: export the variables in your shell, or run
#   set -a; . ./.env; set +a

# Language model for generation, verification and judging. One of:
#   offline  no model: extractive "generator" + lexical checks (instant, used by tests and CI)
#   local    small instruct model run on the CPU inside Node via transformers.js (~1 GB download, once)
#   ollama   a model served by a local Ollama install (https://ollama.com)
LLM_PROVIDER=offline
# Leave empty for the defaults: local = onnx-community/Qwen2.5-1.5B-Instruct, ollama = qwen2.5:1.5b / llama3.2:3b
GENERATOR_MODEL=
JUDGE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings and reranking. "offline" = hashed bag-of-words (no download).
# "local" = BGE-small embeddings (~130 MB) / MiniLM cross-encoder (~90 MB) via transformers.js on the CPU.
# RERANKER also accepts "none".
EMBEDDER=offline
RERANKER=offline

# How (sentence, source) pairs are checked: lexical | nli | llm.
# Default: lexical when offline, otherwise nli (DeBERTa-v3-xsmall NLI model, ~70 MB).
VERIFIER=

# Optional overrides. Leave unset unless you're experimenting.
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# NLI_MODEL=Xenova/nli-deberta-v3-xsmall
# LOCAL_LLM_DTYPE=q4
# LOCAL_LLM_MAX_TOKENS=400
# EVAL_CONCURRENCY=1             # >1 only helps with Ollama; the in-process model runs one call at a time
# INDEX_PATH=data/index/index.json
# QUERY_LOG=data/logs/queries.jsonl
