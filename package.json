{
  "name": "cited-rag-evals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "corpus": "tsx scripts/fetch-corpus.ts",
    "ingest": "pnpm --filter @cre/rag ingest",
    "ask": "pnpm --filter @cre/rag ask",
    "eval": "pnpm --filter @cre/evals eval",
    "eval:smoke": "pnpm --filter @cre/evals eval --subset smoke",
    "ablate": "pnpm --filter @cre/evals ablate",
    "check-gold": "pnpm --filter @cre/evals check-gold",
    "gate": "pnpm --filter @cre/evals gate",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@types/node": "22.13.14",
    "eslint": "9.23.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "typescript-eslint": "8.29.0",
    "vitest": "3.1.1"
  }
}
